# DEVELOPMENT defaults. For production use .env.production.example: with APP_ENV=production
# the API refuses to start on these development values (see README "Production environment variables").
# APP_ENV must be exactly development, test or production.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://alc:alc_dev_password@localhost:5432/alc_growth
REDIS_URL=redis://localhost:6379/0
# Login rate limiting (applied before any password check; no account lockout)
LOGIN_IP_LIMIT=100
LOGIN_IP_WINDOW_SECONDS=600
LOGIN_PAIR_FAILURE_LIMIT=8
LOGIN_PAIR_FAILURE_WINDOW_SECONDS=900
LOGIN_FALLBACK_MAX_KEYS=10000
# Comma-separated reverse-proxy addresses/CIDRs allowed to set X-Forwarded-For, e.g. 127.0.0.1/32.
# Leave empty unless the API sits behind that proxy; private ranges are never trusted by default.
# When TRUSTED_PROXY_CIDRS is used, Uvicorn proxy-header processing must be disabled with
# --no-proxy-headers (never FORWARDED_ALLOW_IPS). See README "Reverse proxy and client IP".
TRUSTED_PROXY_CIDRS=
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10485760
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alc-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PRESIGN_SECONDS=300
DEV_ADMIN_PASSWORD=change-me-before-use
DEV_ALC_PASSWORD=change-me-before-use
# Frontend (read by Vite at build/dev time). Production builds use VITE_API_URL=/api.
VITE_API_URL=http://localhost:8000/api

