# PRODUCTION environment template. Placeholders only: replace every <...> value on the server
# and never commit the real file. With APP_ENV=production the API refuses to start while any
# value below is missing, a default/placeholder, or otherwise unsafe (README "Production
# environment variables"). The startup error names the keys, never the values.
APP_ENV=production

# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<random-secret-from-the-command-above>
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Private / loopback services on the server.
DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@127.0.0.1:5432/alc_growth
REDIS_URL=redis://127.0.0.1:6379/0

# Reverse proxy on the same server. Uvicorn: --host 127.0.0.1 --port 8000 --no-proxy-headers
TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Same-origin deployment: leave empty. Otherwise exact https:// origins only (no *, no localhost).
CORS_ORIGINS=

# Private evidence storage (MinIO or another S3-compatible service). Use a least-privilege
# service account, never the MinIO root user / minioadmin.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=alc-evidence
S3_ACCESS_KEY=<storage-access-key>
S3_SECRET_KEY=<storage-secret-key-at-least-16-characters>
S3_PRESIGN_SECONDS=300

# Login rate limiting (note the exact name LOGIN_PAIR_FAILURE_WINDOW_SECONDS).
LOGIN_IP_LIMIT=100
LOGIN_IP_WINDOW_SECONDS=600
LOGIN_PAIR_FAILURE_LIMIT=8
LOGIN_PAIR_FAILURE_WINDOW_SECONDS=900
LOGIN_FALLBACK_MAX_KEYS=10000

MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10485760

# Frontend build (set when running `npm run build`, not read by the API):
# VITE_API_URL=/api
