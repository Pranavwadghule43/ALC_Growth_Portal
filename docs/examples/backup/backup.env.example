# SAMPLE backup environment (placeholders only). Install as /etc/alc-growth/backup.env,
# owner root, mode 0600. Never commit real values.
BACKUP_ROOT=/srv/alc-growth/backups
BACKUP_PYTHON=/opt/alc-growth/apps/api/.venv/bin/python
APP_RELEASE=<release tag, only if the server has no git checkout>

# PostgreSQL (libpq variables). Password in PGPASSFILE (mode 0600):
#   127.0.0.1:5432:alc_growth:<backup-role>:<password>
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=<backup-role>
PGDATABASE=alc_growth
PGPASSFILE=/etc/alc-growth/backup.pgpass

# Evidence storage: same variables as the API. Use a READ-ONLY key for backups.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=alc-evidence
S3_ACCESS_KEY=<read-only-backup-access-key>
S3_SECRET_KEY=<read-only-backup-secret-key>

# Retention (operational recommendation, not a contractual requirement)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
